# Public Supabase config — safe to expose in browser bundle.
# Real values live in .env (managed by Lovable Cloud) and are NOT committed.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Server-only secrets (edge functions) — configure via Lovable Cloud secrets,
# NEVER put real values here or in any committed file:
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY
#   LOVABLE_API_KEY
#   TELEGRAM_API_KEY